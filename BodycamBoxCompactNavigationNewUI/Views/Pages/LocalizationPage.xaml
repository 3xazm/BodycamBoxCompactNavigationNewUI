<Page
    x:Class="BodycamBoxCompactNavigationNewUI.Views.Pages.LocalizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid Margin="10,20,0,0">

        <StackPanel>

            <!-- 标题 -->
            <TextBlock Text="中文汉化包"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Margin="0,0,0,15"/>

            <!-- ================= 2026 ================= -->
            <Border CornerRadius="15"
                    Padding="20"
                    Margin="0,0,0,15"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">

                <StackPanel>

                    <TextBlock Text="Bodycam 汉化补丁"
                               FontSize="18"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="说明： 20260309"
                               Opacity="0.7"
                               Margin="0,15,0,15"/>

                    <StackPanel Orientation="Horizontal">

                        <ui:Button Content="添加"
                                   Width="100"
                                   Margin="0,0,10,0"
                                   Click="Add2026_Click"/>

                        <ui:Button Content="删除"
                                   Width="100"
                                   Click="RemoveLocalization_Click"/>

                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- ================= 2025 ================= -->
            <Border CornerRadius="15"
                    Padding="20"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">

                <StackPanel>

                    <TextBlock Text="Bodycam 汉化补丁"
                               FontSize="18"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="说明：汉化补丁2025-11-30下午16点 (修复无法创建房间、村庄电视指示改回英文-东西北)"
                               Opacity="0.7"
                               Margin="0,15,0,15"
                               TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal">

                        <ui:Button Content="添加"
                                   Width="100"
                                   Margin="0,0,10,0"
                                   Click="Add2025_Click"/>

                        <ui:Button Content="删除"
                                   Width="100"
                                   Click="RemoveLocalization_Click"/>

                    </StackPanel>

                </StackPanel>
            </Border>

        </StackPanel>

    </Grid>
</Page>