<Page
    x:Class="BodycamBoxCompactNavigationNewUI.Views.Pages.LocalizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:BodycamBoxCompactNavigationNewUI.Views.Pages"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid Margin="10,20,0,0">

        <StackPanel>

            <!-- 标题 -->
            <TextBlock Text="                           汉化包添加✔️ 与 汉化包历史🕒"
                       FontSize="24"
                       Foreground="#8B0000"
                       FontWeight="SemiBold"
                       Margin="0,0,0,15" />


            <!-- ================= 2026 6/21 patch================= -->
            <Border CornerRadius="15"
                    Padding="20"
                    Margin="0,0,0,15"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="2" 
                    Height="184"
                    >

                <StackPanel>

                    <TextBlock Text="Bodycam 汉化补丁 4"
                               FontSize="18"
                               Foreground="#942222"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="补丁修复  “团队死亡竞赛” 和 “武器大乱斗 ”  (修复无法开房问题) "
                               Opacity="0.7"
                               Margin="0,15,0,15"/>

                    <StackPanel Orientation="Horizontal">

                        <ui:Button Content="添加"
                               Width="100"
                               Margin="0,0,10,0"
                               Click="Add2026patch_Click"/>

                        <ui:Button Content="删除"
                               Width="100"
                               Click="RemoveLocalization_Click"/>

                    </StackPanel>

                    <TextBlock Text="2026年6月21日"
                            Opacity="0.7"
                            Foreground="#90E0EF"
                            Margin="0,20,0,20"/>

                </StackPanel>
            </Border>


            <!-- ================= 2026 arui And metaOBS ================= -->
            <Border CornerRadius="15"
                    Padding="20"
                    Margin="0,0,0,15"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="2" 
                    Height="184"
                    >

                <StackPanel>

                    <TextBlock Text="Bodycam 汉化补丁 3"
                   FontSize="18"
                   Foreground="#942222"
                   FontWeight="SemiBold"/>

                    <TextBlock Text=" 2026年 5月 阿锐和 MetaOBS 汉化补丁"
                   Opacity="0.7"
                   Margin="0,15,0,15"/>

                    <StackPanel Orientation="Horizontal">

                        <ui:Button Content="添加"
                       Width="100"
                       Margin="0,0,10,0"
                       Click="Add2026AruiAndmetaOBS_Click"/>

                        <ui:Button Content="删除"
                       Width="100"
                       Click="RemoveLocalization_Click"/>

                    </StackPanel>

                    <TextBlock Text="2026年5月15日"
                                Opacity="0.7"
                                Foreground="#90E0EF"
                                Margin="0,20,0,20"/>

                </StackPanel>
            </Border>

            <!-- ================= 2026 ================= -->
            <Border CornerRadius="15"
                    Padding="20"
                    Margin="0,0,0,15"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="2" 
                    Height="184"
                    >

                <StackPanel>

                    <TextBlock Text="Bodycam 汉化补丁 2"
                               FontSize="18"
                               Foreground="#942222"
                               FontWeight="SemiBold"/>

                    <TextBlock Text=" 2026 03 09"
                               Opacity="0.7"
                               Margin="0,15,0,15"/>

                    <StackPanel Orientation="Horizontal">

                        <ui:Button Content="添加"
                                   Width="100"
                                   Margin="0,0,10,0"
                                   Click="Add2026_Click"/>

                        <ui:Button Content="删除"
                                   Width="100"
                                   Click="RemoveLocalization_Click"/>

                    </StackPanel>

                    <TextBlock Text="2026年3月09日"
                                Opacity="0.7"
                                Foreground="#90E0EF"
                                Margin="0,20,0,20"/>

                </StackPanel>
            </Border>

            <!-- ================= 2025 ================= -->
            <Border CornerRadius="15"
                    Padding="20"
                    Margin="0,0,0,15"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="2" 
                    Height="184"
                    >

                <StackPanel>

                    <TextBlock Text="Bodycam 汉化补丁 1"
                               FontSize="18"
                               Foreground="#942222"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="汉化补丁2025-11-30下午16点 (修复无法创建房间、村庄电视指示改回英文-东西北)"
                               Opacity="0.7"
                               Margin="0,15,0,15"
                               TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal">

                        <ui:Button Content="添加"
                                   Width="100"
                                   Margin="0,0,10,0"
                                   Click="Add2025_Click"/>

                        <ui:Button Content="删除"
                                   Width="100"
                                   Click="RemoveLocalization_Click"/>

                    </StackPanel>

                    <TextBlock Text="2025年11月30日"
                                Opacity="0.7"
                                Foreground="#90E0EF"
                                Margin="0,20,0,20"/>
                    
                </StackPanel>
            </Border>

        </StackPanel>

    </Grid>
</Page>