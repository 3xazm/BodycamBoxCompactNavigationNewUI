<Page
    x:Class="BodycamBoxCompactNavigationNewUI.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BodycamBoxCompactNavigationNewUI.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="DashboardPage"
    d:DataContext="{d:DesignInstance local:DashboardPage, IsDesignTimeCreatable=False}"
    d:DesignHeight="900"
    d:DesignWidth="850"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="11*"/>
            <ColumnDefinition Width="300*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="202*"/>
            <RowDefinition Height="423*"/>
        </Grid.RowDefinitions>

        <!-- 顶部图片 -->
        <Grid x:Name="BannerGrid"
              Grid.Column="1"
              Grid.RowSpan="2"
              Margin="-10,-10,70,100"
              Height="300"
              
              VerticalAlignment="Top">

            <Border 
                CornerRadius="20"
                ClipToBounds="True" Margin="0,-25,0,25">

                <Image
                    x:Name="MyImage"
                    Source="pack://application:,,,/Assets/Bodycam2name.jpg"
                    Stretch="None" 
                    Margin="5,0,55,0"
                     RenderTransformOrigin="1,1" Height="300"/>
            </Border>
        </Grid>

        <!-- 空 -->
        <Grid 
      Height="200"
      Margin="100,10,0,0">

            <Border CornerRadius="20" ClipToBounds="True">

            </Border>
        </Grid>

        <!-- 可滚动区域 -->
        <ScrollViewer
            x:Name="DashboardScrollViewer"
            Margin="50,78,20,0"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            PanningMode="VerticalOnly"
            PreviewMouseWheel="DashboardScrollViewer_PreviewMouseWheel"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Padding="1">

            <StackPanel>

                <!-- 分辨率卡片 -->
                <Border CornerRadius="12"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="3"
                        Padding="15"
                        Margin="0,0,0,15"
                        MouseLeftButtonUp="GoResolutionPage"
                        Cursor="Hand">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="533*"/>
                            <ColumnDefinition Width="94*"/>
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Symbol="Desktop24"
                                       Width="32"
                                       Height="32"
                                       VerticalAlignment="Center" Margin="9,0,9,0"/>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0" Grid.ColumnSpan="2">
                            <TextBlock Text="分辨率"
                                       FontSize="16"
                                       Foreground="#00FFFF"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="纠正复杂显示环境下的分辨率缩放偏差"
                                       FontSize="12"
                                       Opacity="0.7"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 玩家备份卡片 -->
                <Border CornerRadius="12"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="3" 
                        Padding="15"
                        Margin="0,0,0,15"
                        MouseLeftButtonUp="GoBackupPage"
                        Cursor="Hand">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Symbol="Save24"
                                       Width="32"
                                       Height="32"
                                       VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="玩家备份"
                                       FontSize="16"
                                       Foreground="#a4c9cc"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="本地存档备份与恢复，轻松实现多设备数据迁移。"
                                       FontSize="12"
                                       Opacity="0.7"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 汉化包卡片 -->
                <Border CornerRadius="12"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="3"
                        Padding="15"
                        Margin="0,0,0,15"
                        MouseLeftButtonUp="GoLocalizationPage"
                        Cursor="Hand">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Symbol="Translate24"
                                       Width="32"
                                       Height="32"
                                       VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="汉化包"
                                       FontSize="16"
                                       Foreground="#CD1C18"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="一键汉化，快速添加汉化包，即刻开启全中文体验。"
                                       FontSize="12"
                                       Opacity="0.7"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                    </Grid>
                </Border>

                <!-- Bodycam优化+ -->
                <Border CornerRadius="12"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                       BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="3"
                        Padding="15"
                        Margin="0,0,0,15"
                        MouseLeftButtonUp="GoBodycamOptimizationPage"
                        Cursor="Hand">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Symbol="TopSpeed24"
                       Width="32"
                       Height="32"
                       VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Bodycam优化+"
                       FontSize="16"
                       Foreground="#009966"
                       FontWeight="SemiBold"/>

                            <TextBlock Text="加速游戏性能，提升流畅度让游戏更加顺畅！"
                       FontSize="12"
                       Opacity="0.7"
                       Margin="0,5,0,0"/>
                        </StackPanel>

                    </Grid>
                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>
</Page>
