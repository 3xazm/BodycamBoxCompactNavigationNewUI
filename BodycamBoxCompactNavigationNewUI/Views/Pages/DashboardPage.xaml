<Page
    x:Class="BodycamBoxCompactNavigationNewUI.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BodycamBoxCompactNavigationNewUI.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="DashboardPage"
    d:DataContext="{d:DesignInstance local:DashboardPage, IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid>

        <!-- 顶部图片 -->
        <Grid x:Name="BannerGrid"
              VerticalAlignment="Top"
              Height="260"
              Margin="100,10,0,0">

            <Border CornerRadius="20" ClipToBounds="True">
                <Image
                    Source="pack://application:,,,/Assets/bodycamsteam.jpg"
                    x:Name="MyImage"
                    Stretch="Fill"/>
            </Border>
        </Grid>

        <!-- 可滚动区域 -->
        <ScrollViewer
            Margin="50,280,20,0"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            PanningMode="VerticalOnly">

            <StackPanel>

                <!-- 分辨率卡片 -->
                <Border CornerRadius="12"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        Padding="15"
                        Margin="0,0,0,15"
                        MouseLeftButtonUp="GoResolutionPage"
                        Cursor="Hand">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Symbol="Desktop24"
                                       Width="32"
                                       Height="32"
                                       VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="分辨率"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="纠正复杂显示环境下的分辨率缩放偏差"
                                       FontSize="12"
                                       Opacity="0.7"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 玩家备份卡片 -->
                <Border CornerRadius="12"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        Padding="15"
                        Margin="0,0,0,15"
                        MouseLeftButtonUp="GoBackupPage"
                        Cursor="Hand">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Symbol="Save24"
                                       Width="32"
                                       Height="32"
                                       VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="玩家备份"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="本地存档备份与恢复，轻松实现多设备数据迁移。"
                                       FontSize="12"
                                       Opacity="0.7"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 汉化包卡片 -->
                <Border CornerRadius="12"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        Padding="15"
                        MouseLeftButtonUp="GoLocalizationPage"
                        Cursor="Hand">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Symbol="Translate24"
                                       Width="32"
                                       Height="32"
                                       VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="汉化包"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="一键汉化，快速添加汉化包，即刻开启全中文体验。"
                                       FontSize="12"
                                       Opacity="0.7"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                    </Grid>
                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>
</Page>