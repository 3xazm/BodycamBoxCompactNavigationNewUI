<Page
    x:Class="BodycamBoxCompactNavigationNewUI.Views.Pages.BodycamOptimizationPage2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:BodycamBoxCompactNavigationNewUI.Views.Pages"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- 根节点直接用 Grid，把滑动完全交给外层主框架导航处理 -->
    <Grid Margin="20">
        <StackPanel>



            <!-- 脸部马赛克 模块 -->
            <Border CornerRadius="25"
                    Padding="25"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="3"
                    Margin="0,0,0,20">

                <Grid Margin="0,9,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左边内容区 -->
                    <StackPanel Margin="0,0,0,-15">
                        <TextBlock Text="脸部马赛克 1"
                                   FontSize="20"
                                   Foreground="#00CED1"
                                   FontWeight="Bold"/>

                        <!-- 动态状态显示：绑定后端 Brush，开关红绿灯 -->
                        <TextBlock Text="{Binding ViewModel.FaceMosaicStatus}"
                                   Foreground="{Binding ViewModel.FaceMosaicStatusBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,12,0,0"/>

                        <TextBlock Text=" " Margin="0,10,0,0" TextWrapping="Wrap"/>

                        <!-- 条目说明 -->
                        <TextBlock Text="1- 该模式激活后，支持在游戏内通过快捷键 F9 自由切换。"
                                   Margin="0,20,0,0"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="2- 单次触发将直接取消游戏中玩家的脸部马赛克。"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="3- 二次触发将瞬间还原马赛克遮罩效果，恢复原样。"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"/>


                    </StackPanel>

                    <!-- 右边控制按钮 -->
                    <Button Grid.Column="1"
                            Content="关闭 / 激活"
                            Width="115"
                            Height="40"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="#00CED1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="4"
                            Command="{Binding ViewModel.ToggleFaceMosaicCommand}"
                            Margin="-10,0,0,0"/>
                </Grid>
            </Border>



        </StackPanel>
    </Grid>
</Page>